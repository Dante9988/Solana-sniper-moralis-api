# Token intelligence — Anthropic AI synthesis (Phase 3)
# Names only. Never commit real values here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_MS=15000
ANTHROPIC_MAX_TOKENS=1024

# Solana forensics — durable worker (Phase 5D). Names only.
# Worker disabled, concurrency 1, and DEEP analysis disabled by default.
FORENSICS_WORKER_ENABLED=false
FORENSICS_WORKER_CONCURRENCY=1
FORENSICS_JOB_POLL_MS=5000
FORENSICS_JOB_LEASE_MS=120000
FORENSICS_JOB_HEARTBEAT_MS=30000
FORENSICS_JOB_MAX_ATTEMPTS=5
FORENSICS_JOB_BASE_BACKOFF_MS=5000

# Solana forensics — intelligence integration (Phase 5E). Names only.
# All disabled by default; enabling them does not itself start any live
# Helius/RPC work — the standalone worker (FORENSICS_WORKER_ENABLED) still
# owns all expensive analysis.
FORENSICS_ENQUEUE_ENABLED=false
FORENSICS_RECONCILIATION_ENABLED=false
FORENSICS_AI_RESYNTHESIS_ENABLED=false

# X API — read-only capability checkpoint (Phase X). Names and safe example
# defaults only; never commit a real bearer token here. Streaming stays
# disabled; only the explicit `npm run x:smoke` command ever reads the token.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
X_STREAM_ENABLED=false
X_REQUEST_TIMEOUT_MS=8000

# Presentation layer / canonical /api/v1 gateway (Phase 6, evolved in
# Phase 7B.1). Names only; never commit real values. Reuses DATABASE_URL
# and the existing forensics/intelligence tables — no new data source.
API_PORT=8787
# API_KEYS is for internal/admin/server-to-server callers only (phase7b1.txt
# §5) — never ship this to the Vite web app or the Expo mobile app. Public
# clients authenticate with their own Supabase access token instead (below).
API_KEYS=
API_PUBLIC_READS=false
PRESENTATION_RATE_LIMIT_PER_MIN=30
SCAN_ENQUEUE_LIMIT_PER_HOUR=6

# Supabase JWT verification (Phase 7B.1, phase7b1.txt §5). SUPABASE_URL is
# the only required setting — the modern ES256/RS256 signing key is fetched
# from that project's own published JWKS endpoint automatically. Set
# SUPABASE_JWT_SECRET only if this project still uses the legacy shared
# HS256 secret (Settings -> API -> JWT Settings). Leaving SUPABASE_URL unset
# disables Supabase auth entirely — GET /api/v1/me fails closed (503), and
# the token-intelligence routes fall back to API_KEYS-only.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# CORS allowlist for the /api/v1 gateway (Phase 7B.1, phase7b1.txt §8). Never
# a wildcard. Comma-separated exact origins, e.g. https://app.onlypump.me.
# CORS_DEV_ORIGINS only applies outside NODE_ENV=production (defaults to the
# usual Vite/Expo localhost ports when unset).
CORS_ALLOWED_ORIGINS=
CORS_DEV_ORIGINS=

# Rate-limit backend for the /api/v1 gateway (Phase 7B.1, phase7b1.txt §9).
# "memory" is fine for local dev and a single instance; a multi-instance
# production deployment needs "redis" (+ REDIS_URL) so limits are actually
# shared across processes — NODE_ENV=production refuses to start without
# RATE_LIMIT_BACKEND being set explicitly to one or the other.
RATE_LIMIT_BACKEND=memory
REDIS_URL=

# Wallet-ownership challenge binding (Phase 7B.2, phase7b2.txt §2) — baked
# into every challenge message server-side, never taken from request input.
ONLYPUMP_DOMAIN=onlypump.me
ONLYPUMP_URI=https://onlypump.me

# Event bus (job lifecycle events) + WebSocket ticket store (Phase 7B.2,
# phase7b2.txt §4/§6). Same fail-closed rule as RATE_LIMIT_BACKEND: memory
# only works within one process, so a worker process's job-lifecycle events
# would never reach a separate API/WebSocket process, and a ticket issued by
# one API instance wouldn't be recognized by another — NODE_ENV=production
# refuses to start without REALTIME_BACKEND set explicitly. Reuses REDIS_URL
# above when set to "redis".
REALTIME_BACKEND=memory
WS_TICKET_TTL_MS=45000
WS_MAX_MESSAGE_BYTES=8192
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=20
WS_MAX_CONNECTIONS_PER_USER=5
WS_IDLE_TIMEOUT_MS=60000

# Telegram trading bot (merged from main2, see ARCHITECTURE.md §8). Names
# only. TELEGRAM_BOT_TOKEN starts a live bot as soon as `npm run dev` runs.
# TELEGRAM_ADMIN_IDS is a comma-separated allowlist of Telegram user IDs —
# empty/unset means nobody can use /buy, /sell, or /wallet connect|disconnect
# (fails closed, not open).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_ALERTS_ENABLED=false
TELEGRAM_ADMIN_IDS=

# Same allowlist concept for Discord's /buy, /sell, /wallet (slash commands
# and the DM-based text command handler) — comma-separated Discord user IDs.
# Empty/unset means nobody can use them.
DISCORD_ADMIN_IDS=

# main2's own API/websocket server (src/api/index.ts) — a DIFFERENT process
# and a DIFFERENT API_PORT default than the Phase 6 research API above.
# Off by default — set API_ENABLED=true to let `npm run dev` start it.
# Binds 0.0.0.0 by default. Every /api/* route requires API_AUTH_TOKEN
# (fails closed with 503 if unset) — /health, /, and the Solana Pay /pay/*
# routes are exempt (the latter must stay unauthenticated per spec).
API_ENABLED=false
API_HOST=0.0.0.0
API_PORT_MAIN=3030
API_AUTH_TOKEN=

# Non-custodial trade signing (Solana Pay Transaction Requests, see
# ARCHITECTURE.md §8). Must be a real, publicly reachable HTTPS URL that a
# wallet app can fetch — /buy and /sell fail closed without it. This is the
# base URL for whichever process serves src/api/index.ts's /pay/* routes.
SOLANA_PAY_BASE_URL=

# RPC endpoint used by jupiterService.ts's non-custodial transaction builder
# (falls back to HELIUS_HTTPS_URI, then a public mainnet-beta endpoint).
RPC_ENDPOINT=

# Robinhood Chain / Pons ingestion (Phase 7B.4, hardened in Phase 7B.5A).
# Names only — never commit real values. `npm run pons:worker` requires
# every setting through WETH_QUOTE below (loadRobinhoodChainConfig fails
# closed if any is missing); the read-only `npm run api` process does not
# need these — its /api/v1/tokens/robinhood/status route only needs the
# PONS_HEALTH_* settings further down (loadPonsHealthThresholds).
ROBINHOOD_CHAIN_ID=
ROBINHOOD_RPC_HTTPS=
# Recorded live as a raw Arbitrum Nitro sequencer feed, not a JSON-RPC
# pubsub endpoint (ARCHITECTURE.md §19.1) — kept for completeness/telemetry
# only, never opened for eth_subscribe by this worker.
ROBINHOOD_RPC_WSS=
ROBINHOOD_EXPLORER=
PONS_FACTORY=
PONS_LOCKER=
PONS_FACTORY_LEGACY=
PONS_LOCKER_LEGACY=
WETH_QUOTE=

# Optional Pons tuning — see prisma/schema.prisma's ChainIngestionCheckpoint
# and src/pons/config.ts for what each controls. All must be positive
# integers if set.
PONS_POLL_INTERVAL_MS=5000
PONS_GRADUATION_POLL_INTERVAL_MS=60000
PONS_MAX_BLOCK_RANGE_PER_POLL=2000
PONS_CONFIRMATION_LAG_BLOCKS=5
PONS_FRESH_START_LOOKBACK_BLOCKS=1000

# Phase 7B.5A — batch discovery enrichment (bounded concurrency, never
# unbounded Promise.all; src/pons/discoveryListener.ts).
PONS_ENRICHMENT_CONCURRENCY=5
PONS_ENRICHMENT_RETRY_BATCH_SIZE=25

# Phase 7B.5A — chunked trade-pool log queries (src/pons/tradeListener.ts).
# Full completeness is preserved (pools are never aged out); this only
# bounds how many addresses go into a single eth_getLogs call.
PONS_TRADE_POOL_CHUNK_SIZE=40
PONS_TRADE_QUERY_CONCURRENCY=3

# Phase 7B.5A — bounded reorg recovery window (src/pons/reorgRecovery.ts).
# How many recent committed (height,hash) checkpoints recovery will search
# backward through for a common canonical ancestor before failing closed.
PONS_REORG_MAX_DEPTH_BLOCKS=500

# Phase 7B.5A — source-health projection thresholds
# (src/pons/sourceHealth.ts, GET /api/v1/tokens/robinhood/status). Read by
# both the worker and the read-only API process independently.
PONS_HEALTH_LAGGING_BLOCKS=50
PONS_HEALTH_STALE_MS=120000
PONS_HEALTH_ERROR_WINDOW_MS=60000

# Phase 7B.5B — candle worker (src/candles/scripts/candlesWorkerMain.ts,
# `npm run candles:worker`). Requires the same ROBINHOOD_RPC_HTTPS/PONS_*/
# WETH_QUOTE settings above (read-only; used only to resolve each token's
# verified ERC-20 decimals(), never to serve API requests). Single-replica
# only — no lease/partitioning mechanism, same as pons:worker.
CANDLES_POLL_INTERVAL_MS=5000
CANDLES_MAX_INVALIDATION_TOKENS_PER_TICK=25
CANDLES_MAX_FORWARD_TOKENS_PER_TICK=100
CANDLES_TRADE_PAGE_CAP=5000

# Phase 7B.5B — candle service health thresholds
# (src/candles/health.ts, extends GET /api/v1/tokens/robinhood/:tokenAddress/candles's
# `freshness` field). Read by both the worker and the read-only API process
# independently (loadCandleHealthThresholds() needs no RPC/contract config).
CANDLES_HEALTH_STALE_MS=120000
CANDLES_HEALTH_ERROR_WINDOW_MS=60000
CANDLES_HEALTH_LAGGING_MS=30000
