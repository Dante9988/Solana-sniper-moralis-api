generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id            String              @id @default(uuid())
  userId        String              @unique
  walletAddress String              @unique
  /// Deliberately optional and never populated by any code path anymore —
  /// this bot never generates, imports, or stores a private key (see
  /// ARCHITECTURE.md §8). Kept nullable rather than dropped so existing rows
  /// (from before this change) aren't touched by a destructive migration.
  walletPk      String?             @unique
  createdAt     DateTime            @default(now())
  config        UserConfig?
  balances      WalletBalance[]
  transactions  WalletTransaction[]
}

model UserConfig {
  id         String  @id @default(uuid())
  userId     String  @unique
  autoBuy    Boolean @default(false)
  buyAmount  Float   @default(0.1)
  takeProfit Float   @default(50)
  stopLoss   Float   @default(25)
  autoSell   Boolean @default(false)
  wallet     Wallet  @relation(fields: [userId], references: [userId])
}

model PumpFunToken {
  mint      String   @id
  createdAt DateTime @default(now())
  alerted   Boolean  @default(false)
}

model TokenAlert {
  id               String    @id @default(uuid())
  tokenAddress     String
  tokenSymbol      String?
  tokenName        String?
  initialMarketCap Float
  initialPrice     Float
  bundlePercentage Float?
  alertTimestamp   DateTime  @default(now())
  checked          Boolean   @default(false)
  pnlAlerted       Boolean   @default(false)
  pnlPercentage    Float?
  currentMarketCap Float?
  currentPrice     Float?
  checkTimestamp   DateTime?

  @@index([tokenAddress])
  @@index([checked])
  @@index([alertTimestamp])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String
  tokenMint   String
  tokenAmount Float
  solAmount   Float
  price       Float
  txHash      String
  timestamp   DateTime @default(now())
  status      String
  error       String?
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([tokenMint])
  @@index([timestamp])
}

model WalletBalance {
  id          String   @id @default(uuid())
  walletId    String
  tokenMint   String
  amount      Float
  lastUpdated DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@unique([walletId, tokenMint])
  @@index([walletId])
  @@index([tokenMint])
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  /// A Telegram DM ALERT/NOTIFICATION opt-in only (see src/telegram/commands/togglePumpSwap.ts
  /// and src/telegram/alerts.ts). Despite the name, this never gates trade execution — no
  /// execution code path reads it. Real PumpSwap AMM swap execution is not implemented
  /// anywhere in this codebase (ARCHITECTURE.md §8.2); defaulting this to true only means a
  /// new user receives Pump.fun token alert DMs by default, not that any trading is enabled.
  pumpSwapEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// --- Token Intelligence layer (read-only research/reporting; no execution) ---

model TokenIntelligenceReport {
  id      String @id @default(uuid())
  eventId String @unique
  mint    String

  // token
  tokenName         String?
  tokenSymbol       String?
  tokenImageUrl     String?
  tokenMetadataUri  String?
  tokenCreator      String?
  tokenCreationTime DateTime?

  // socials
  socialWebsite  String?
  socialTwitter  String?
  socialTelegram String?
  socialDiscord  String?
  socialFindings Json    @default("[]")

  // market
  marketPrice     Float?
  marketCap       Float?
  marketFdv       Float?
  marketLiquidity Float?
  marketVolume24h Float?
  marketHolders   Int?
  marketPools     Json   @default("[]")
  marketSources   Json   @default("[]")

  // safety
  safetyMintAuthority             String?
  safetyFreezeAuthority           String?
  safetyCreatorHoldingsPct        Float?
  safetyTopHolderConcentrationPct Float?
  safetyRugCheck                  Json?
  safetySolSniffer                Json?
  safetyRiskFactors               Json    @default("[]")
  safetyConfidence                Float   @default(0)

  // bundlesAndSnipers
  bundleSniperPct  Float?
  bundleBundledPct Float?
  bundleFindings   Json   @default("[]")
  bundleConfidence Float  @default(0)

  // aiAssessment
  aiNarrative           String?
  aiCategory            String?
  aiRiskLevel           String  @default("UNKNOWN")
  aiConfidence          Float   @default(0)
  aiPositiveSignals     Json    @default("[]")
  aiRiskFactors         Json    @default("[]")
  aiReasons             Json    @default("[]")
  aiMissingInfo         Json    @default("[]")
  aiDataQualityWarnings Json    @default("[]")
  aiRecommendation      String  @default("RESEARCH_ONLY")

  // aiAssessment.meta — Anthropic provider telemetry (Phase 3)
  aiProvider         String?
  aiModel            String?
  aiPromptVersion    String?
  aiSchemaVersion    String?
  aiLatencyMs        Int?
  aiInputTokens      Int?
  aiOutputTokens     Int?
  aiCompletedAt      DateTime?
  aiValidationStatus String?
  aiFailureReason    String?

  // processing
  status      String
  startedAt   DateTime
  completedAt DateTime?

  evidence TokenIntelligenceEvidence[]
  errors   TokenIntelligenceError[]

  // forensics (Phase 5E) — deterministic, separate from aiAssessment.
  // Denormalized from the latest reconciled SolanaForensicsRun; the run
  // itself remains the immutable audit record, never overwritten here.
  forensicsStatus                          String    @default("NOT_REQUESTED")
  forensicsJobId                           String?
  forensicsRunId                           String?
  forensicsAnalysisLevel                   String?
  forensicsPolicyVersion                   String?
  forensicsEligibility                     String?
  forensicsDisplaySeverity                 String?
  forensicsReasonCodes                     Json      @default("[]")
  forensicsRequiredEvidenceComplete        Boolean   @default(false)
  forensicsInitialBundledAcquisitionPct    Decimal?  @db.Decimal(9, 4)
  forensicsCurrentBundleWalletHoldingsPct  Decimal?  @db.Decimal(9, 4)
  forensicsDeveloperClusterHoldingsPct     Decimal?  @db.Decimal(9, 4)
  forensicsSuspectedCoordinatedHoldingsPct Decimal?  @db.Decimal(9, 4)
  forensicsInsiderHoldingsPct              Decimal?  @db.Decimal(9, 4)
  forensicsSniperHoldingsPct               Decimal?  @db.Decimal(9, 4)
  forensicsAdjustedTop10HoldingsPct        Decimal?  @db.Decimal(9, 4)
  forensicsCompletedAt                     DateTime?
  forensicsReconciledAt                    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mint])
  @@index([status])
  @@index([createdAt])
  @@index([forensicsStatus])
  @@index([forensicsRunId])
}

model TokenIntelligenceEvidence {
  id        String                  @id @default(uuid())
  reportId  String
  report    TokenIntelligenceReport @relation(fields: [reportId], references: [id])
  category  String
  payload   Json
  createdAt DateTime                @default(now())

  @@index([reportId])
  @@index([category])
}

model TokenIntelligenceError {
  id        String                  @id @default(uuid())
  reportId  String
  report    TokenIntelligenceReport @relation(fields: [reportId], references: [id])
  worker    String
  message   String
  fatal     Boolean                 @default(false)
  createdAt DateTime                @default(now())

  @@index([reportId])
  @@index([worker])
}

// Canonical cross-chain research identity. Legacy positions remain separate.
model Asset {
  id                String   @id @default(uuid())
  chain             String
  chainId           String
  address           String
  normalizedAddress String
  symbol            String?
  name              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  observations  AssetObservation[]
  forensicsJobs SolanaForensicsJob[]

  @@unique([chainId, normalizedAddress])
  @@index([chain])
  @@index([normalizedAddress])
}

model AssetObservation {
  id             String   @id @default(uuid())
  assetId        String
  type           String
  source         String
  observationKey String
  observedAt     DateTime
  provider       String?

  priceUsd              Decimal?
  estimatedBuyPriceUsd  Decimal?
  estimatedSellPriceUsd Decimal?
  liquidityUsd          Decimal?
  marketCapUsd          Decimal?
  fdvUsd                Decimal?
  volume24hUsd          Decimal?

  rawPayload Json?
  createdAt  DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, source, observationKey])
  @@index([assetId, observedAt])
  @@index([type, observedAt])
  @@index([source, observedAt])
}

// --- Phase 5D: Solana forensics jobs/runs (durable, additive, read-only research) ---
// Not wired into the active listener or the Phase 1-4 intelligence tables.

model SolanaForensicsJob {
  id                 String  @id @default(uuid())
  /// Stable identity for idempotency: solana-mainnet + normalized mint +
  /// discovery signature/event identity + analysis level + policy version.
  /// Never rely on a nullable composite unique for this.
  jobKey             String  @unique
  assetId            String
  asset              Asset   @relation(fields: [assetId], references: [id])
  mint               String
  eventId            String?
  discoverySignature String?
  discoverySource    String
  analysisLevel      String
  policyVersion      String

  status       String   @default("PENDING")
  priority     Int      @default(0)
  attemptCount Int      @default(0)
  maxAttempts  Int      @default(5)
  availableAt  DateTime @default(now())

  leaseOwner     String?
  leaseExpiresAt DateTime?

  startedAt   DateTime?
  completedAt DateTime?

  lastErrorCode    String?
  lastErrorMessage String?

  runs SolanaForensicsRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([mint])
  @@index([assetId])
}

model SolanaForensicsRun {
  id            String             @id @default(uuid())
  jobId         String
  job           SolanaForensicsJob @relation(fields: [jobId], references: [id])
  assetId       String
  mint          String
  attemptNumber Int
  analysisLevel String
  policyVersion String

  runStatus      String
  coverageStatus String

  launchSlot   Int?
  snapshotSlot Int?

  initialBundleMetricStatus String
  currentBundleMetricStatus String

  // Raw token amounts are never floats — percentages are the only Decimal
  // values persisted here; bounded compact JSON below carries any amounts.
  initialBundledAcquisitionPct   Decimal? @db.Decimal(9, 4)
  currentBundleWalletHoldingsPct Decimal? @db.Decimal(9, 4)
  directDeveloperPct             Decimal? @db.Decimal(9, 4)
  developerClusterPct            Decimal? @db.Decimal(9, 4)
  suspectedCoordinatedPct        Decimal? @db.Decimal(9, 4)
  insiderPct                     Decimal? @db.Decimal(9, 4)
  initialSniperAcquisitionPct    Decimal? @db.Decimal(9, 4)
  currentSniperHoldingsPct       Decimal? @db.Decimal(9, 4)
  boundedFreshWalletHoldingsPct  Decimal? @db.Decimal(9, 4)
  rawTop10Pct                    Decimal? @db.Decimal(9, 4)
  adjustedTop10Pct               Decimal? @db.Decimal(9, 4)
  largestNonSystemHolderPct      Decimal? @db.Decimal(9, 4)

  holderCount            Int?
  holderAccountsAnalyzed Int?
  transactionsAnalyzed   Int?
  walletsAnalyzed        Int?
  estimatedCreditsUsed   Int?
  requestCount           Int?

  reachedConfiguredLimit Boolean @default(false)
  budgetExhausted        Boolean @default(false)
  deadlineExceeded       Boolean @default(false)

  /// Compact, bounded report snapshot (evidence/cluster IDs, not unlimited
  /// raw transaction payloads — those live only as signatures/slots on the
  /// evidence rows below).
  reportJson Json

  evidence    SolanaForensicsEvidence[]
  clusters    SolanaWalletCluster[]
  errors      SolanaForensicsError[]
  eligibility SolanaTokenEligibilityAssessment?

  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  // Reconciliation bookkeeping (Phase 5E) — operational metadata about
  // syncing this run into TokenIntelligenceReport, not forensic content.
  // Never touched by the deterministic forensic content above.
  reconciliationStatus   String    @default("PENDING")
  reconciliationAttempts Int       @default(0)
  reconciliationError    String?
  reconciledAt           DateTime?

  @@index([jobId])
  @@index([assetId])
  @@index([mint, createdAt])
  @@index([reconciliationStatus])
}

model SolanaForensicsEvidence {
  id          String             @id @default(uuid())
  runId       String
  run         SolanaForensicsRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The in-memory ForensicEvidence.id — unique within a run, not globally.
  evidenceKey String
  category    String
  reasonCode  String
  source      String
  signature   String?
  slot        Int?
  wallets     Json               @default("[]")
  amounts     Json?
  retrievedAt DateTime
  createdAt   DateTime           @default(now())

  @@unique([runId, evidenceKey])
  @@index([runId, category])
}

model SolanaWalletCluster {
  id             String                      @id @default(uuid())
  runId          String
  run            SolanaForensicsRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The in-memory WalletCluster.id — unique within a run, not globally.
  clusterKey     String
  classification String
  confidence     Decimal                     @db.Decimal(4, 3)
  reasonCodes    Json                        @default("[]")
  members        SolanaWalletClusterMember[]
  createdAt      DateTime                    @default(now())

  @@unique([runId, clusterKey])
  @@index([runId, classification])
}

model SolanaWalletClusterMember {
  id        String              @id @default(uuid())
  clusterId String
  cluster   SolanaWalletCluster @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  wallet    String
  createdAt DateTime            @default(now())

  @@unique([clusterId, wallet])
  @@index([wallet])
}

model SolanaTokenEligibilityAssessment {
  id                       String             @id @default(uuid())
  runId                    String             @unique
  run                      SolanaForensicsRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  mint                     String
  eligibility              String
  displaySeverity          String
  reasonCodes              Json               @default("[]")
  evaluatedMetrics         Json               @default("{}")
  requiredEvidenceComplete Boolean
  policyVersion            String
  evaluatedAt              DateTime
  createdAt                DateTime           @default(now())

  @@index([mint, createdAt])
  @@index([eligibility])
}

model SolanaForensicsError {
  id         String             @id @default(uuid())
  runId      String
  run        SolanaForensicsRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  stage      String
  message    String
  retryable  Boolean            @default(false)
  occurredAt DateTime
  createdAt  DateTime           @default(now())

  @@index([runId])
}

// --- Phase 7B.2: non-custodial Solana wallet-ownership verification and
// user-scoped scan access (ARCHITECTURE.md §17). `userId` throughout is the
// Supabase auth `sub` claim (a UUID) -- an opaque string with no local FK,
// same convention as Wallet.userId/UserPreference.userId elsewhere in this
// schema (Supabase's own `auth.users` table lives in a separate database).

/// A pending "sign this message to prove you control this address" challenge
/// (SIWS-style, phase7b2.txt §2). `challengeHash` -- not the raw challenge id
/// handed to the client -- is what's stored and indexed, so a read-only
/// database compromise doesn't hand out reusable challenge identifiers
/// (phase7b2.txt §2 "store hashes where practical instead of reusable
/// plaintext secrets"). The exact `message` text is stored in full: unlike
/// the challenge id, the message is meant to be publicly readable -- it's
/// what proves the signature was actually over these exact bytes.
model WalletChallenge {
  id            String    @id @default(uuid())
  challengeHash String    @unique
  userId        String
  address       String
  network       String    @default("solana:mainnet")
  domain        String
  uri           String
  nonce         String
  message       String
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A Solana address whose ownership was proven by a verified detached Ed25519
/// signature over a WalletChallenge (never a private key or seed phrase --
/// see src/researchApi/services/walletVerificationService.ts). Deliberately
/// its own model, not a reuse of Wallet.walletPk (the legacy, now-nullable,
/// never-written custodial column, §8) -- this table never has, and must
/// never gain, a secret-key column of any kind.
/// @@unique([network, address]) means one address can be the *verified*
/// wallet of at most one OnlyPump account at a time (phase7b2.txt §2's
/// default: prevent cross-account claims). Re-verifying under a different
/// account requires unlinking it from the first account first.
model VerifiedWallet {
  id         String   @id @default(uuid())
  userId     String
  address    String
  network    String   @default("solana:mainnet")
  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([network, address])
  @@index([userId])
}

/// Ownership/subscription mapping between an authenticated user, the mint
/// they requested, and the underlying (possibly cross-user-shared/deduped)
/// SolanaForensicsJob.jobKey (phase7b2.txt §3). This is what makes
/// `GET /api/v1/jobs/:jobKey` and realtime job events user-scoped without
/// duplicating or un-deduplicating the underlying forensics work: many users
/// requesting the same mint around the same time still share one job, but
/// each gets their own row here, so one user can never enumerate or read
/// another user's request metadata through this mapping.
model UserScanRequest {
  id          String   @id @default(uuid())
  userId      String
  mint        String
  jobKey      String
  requestedAt DateTime @default(now())

  @@unique([userId, jobKey])
  @@index([jobKey])
  @@index([userId])
}

// --- Phase 7B.3A: Pump.fun/PumpSwap lifecycle and normalized trades ---
//
// Numeric column widths below are chosen from real decoded mainnet values
// gathered during the Phase 7B.3A0/7B.3A1 audit, not guessed:
//   - token/quote/fee amounts are u64 on both programs' IDLs (max
//     18,446,744,073,709,551,615 — 20 digits); Decimal(24,0) gives 4 digits
//     of headroom with no wasted precision.
//   - real observed values ranged from 5 digits (a small buy's
//     base_amount_out) to 16 digits (a fresh mint's token_total_supply,
//     1_000_000_000_000_000) — comfortably inside Decimal(24,0).
//   - i128-typed fields (PumpSwap's virtual_quote_reserves) are NOT given
//     their own typed column — they are not part of the NormalizedPumpTrade
//     contract and are not queried directly; they live only in
//     PumpLifecycleEvent.payload's canonicalized JSON, decimal-string
//     encoded, avoiding a 39-digit column for a field nothing queries.
//   - candle OHLC price fields use Decimal(38,18): checked against both a
//     fresh mint's smallest real implied price (~2.8e-5, from a real
//     CreateEvent's virtual reserves) and a mature pool's largest real
//     implied price (~6.24, from a real $630M-mcap pool's reserves) — both
//     land nowhere near either bound of Decimal(38,18)'s 20-integer-digit /
//     18-fractional-digit range.

model PumpLifecycleEvent {
  id                    String    @id @default(uuid())
  mint                  String
  eventType             String // created | completed | migration_initiated | pumpswap_pool_created | pumpswap_pool_ready
  emittingProgram       String
  signature             String
  outerInstructionIndex Int
  innerPosition         Int // -1 sentinel, never null (Postgres UNIQUE treats multiple NULLs as distinct)
  slot                  BigInt
  /// Nullable until resolved via a cached per-slot getBlock lookup — the
  /// undocumented getTransaction "transactionIndex" field is used as a fast
  /// path when present (confirmed live on this project's actual Helius
  /// endpoint), with getBlock's officially-documented signature-array
  /// position as the durable fallback/cross-check.
  outerTxPosition       Int?
  blockTime             DateTime
  /// The event's own on-chain-asserted timestamp field, when the event
  /// carries one — kept distinct from blockTime and never substituted for
  /// it (CANDLESTICK_CHART.md requires blockTime specifically).
  eventTime             DateTime?
  payloadVersion        Int       @default(1)
  /// Canonicalized: every bigint/BN-typed field pre-converted to a decimal
  /// string before this is written — never a raw JS number for a monetary
  /// or reserve value.
  payload               Json
  poolAddress           String?
  bondingCurveAddress   String?
  status                String // provisional | final | orphaned
  /// live stream | historical backfill | block reconciliation — distinct
  /// ingestion paths must still deduplicate through the identity below.
  source                String
  observedAt            DateTime  @default(now())

  @@unique([signature, outerInstructionIndex, innerPosition, emittingProgram])
  @@index([mint, slot, outerTxPosition, outerInstructionIndex, innerPosition])
}

model TokenLifecycleState {
  mint          String   @id
  state         String // bonding_curve | migrating | pumpswap | unsupported
  bondingCurve  String?
  pumpswapPool  String?
  lastEventId   String
  lastEventSlot BigInt
  updatedAt     DateTime @updatedAt
}

model PumpTrade {
  id                    String    @id @default(uuid())
  venue                 String // pump | pumpswap
  source                String // live stream | historical backfill | block reconciliation
  mint                  String
  quoteMint             String
  signature             String
  outerInstructionIndex Int
  innerPosition         Int // -1 sentinel, never null
  emittingProgram       String
  slot                  BigInt
  outerTxPosition       Int?
  blockTime             DateTime
  eventTime             DateTime?
  side                  String // buy | sell
  tokenAmount           Decimal   @db.Decimal(24, 0)
  quoteAmount           Decimal   @db.Decimal(24, 0)
  trader                String
  status                String // provisional | final | orphaned
  observedAt            DateTime  @default(now())

  @@unique([signature, outerInstructionIndex, innerPosition, emittingProgram])
  @@index([mint, blockTime])
  @@index([mint, slot, outerTxPosition])
}

model PumpCandle {
  mint          String
  resolution    String
  startTime     DateTime
  open          Decimal  @db.Decimal(38, 18)
  high          Decimal  @db.Decimal(38, 18)
  low           Decimal  @db.Decimal(38, 18)
  close         Decimal  @db.Decimal(38, 18)
  volumeToken   Decimal  @db.Decimal(24, 0)
  volumeQuote   Decimal  @db.Decimal(24, 0)
  volumeUsd     Decimal? @db.Decimal(24, 8)
  trades        Int
  /// Always COUNT(DISTINCT trader) over raw PumpTrade for this exact
  /// interval — never summed from smaller sub-candles (not associative).
  uniqueTraders Int
  source        String // pump | pumpswap | mixed
  status        String // provisional | final
  updatedAt     DateTime @updatedAt

  @@id([mint, resolution, startTime])
}

model PumpCandleRevision {
  id             String   @id @default(uuid())
  mint           String
  resolution     String
  startTime      DateTime
  sequence       BigInt   @default(autoincrement())
  revisionStatus String // provisional | final | corrected
  /// Complete serialized candle at this revision — every monetary value a
  /// decimal string, never a JS number (Phase 7B.3A1 override item 7).
  payload        Json
  createdAt      DateTime @default(now())

  @@index([mint, resolution, sequence])
}

model SolUsdRate {
  id             String   @id @default(uuid())
  feedId         String
  provider       String
  publishTime    DateTime
  retrievedAt    DateTime @default(now())
  rawPrice       BigInt
  exponent       Int
  normalizedRate Decimal  @db.Decimal(20, 8)
  providerStatus String?
  supersedesId   String?
  isActive       Boolean  @default(true)

  @@index([provider, publishTime])
  @@index([feedId, publishTime])
}

// ---------------------------------------------------------------------------
// Phase 7B.4 — Robinhood Chain / Pons ingestion.
//
// Deliberately venue-agnostic table names (not Pons-prefixed), mirroring the
// TypeScript contract in src/discovery/types.ts: Pons, PumpSwap and any
// future venue are three sources of the same small set of facts. The
// `chain`/`venue` columns discriminate; the Solana adapter is meant to drop
// in as more rows here later, not a parallel set of tables.
//
// Raw amount columns use Decimal(78, 0) rather than PumpTrade's
// Decimal(24, 0): Solana's u64 amounts fit in 24 digits, but EVM's uint256
// amounts (18-decimal ERC20 supplies routinely exceed 1e27) need headroom
// up to uint256's real max, which is exactly 78 decimal digits.
// ---------------------------------------------------------------------------

/// Phase 7B.5A §2/§9 — CANONICAL rows are current chain facts; ORPHANED rows
/// were reconciled off the canonical chain by reorg recovery (reorgRecovery.ts)
/// and are retained (never deleted) for audit but must never be read as
/// current facts by any API route or aggregation.
enum ChainFactStatus {
  CANONICAL
  ORPHANED
}

/// Phase 7B.5A §4/§9 — COMPLETE once getLaunchedToken() enrichment (supply/
/// isToken0/poolFee) has succeeded; PENDING when the TokenLaunched log itself
/// was decoded and persisted (so the fact is never lost) but enrichment RPC
/// failed and is retried on a later discovery tick. Never fabricate a default
/// for a PENDING row's enrichment fields.
enum EnrichmentStatus {
  COMPLETE
  PENDING
}

model DiscoveredToken {
  id                        String           @id @default(uuid())
  chain                     String // "robinhood" | "solana" (ChainId)
  venue                     String // "pons" | "pumpfun"
  tokenAddress              String
  deployer                  String
  poolAddress               String?
  quoteAddress              String
  supply                    Decimal?         @db.Decimal(78, 0)
  initialBuyAmount          Decimal          @db.Decimal(78, 0)
  /// From the same getLaunchedToken() enrichment read as supply -- needed by
  /// the trade listener to interpret Swap's signed amount0/amount1 without
  /// an extra RPC call per trade. Null while enrichmentStatus is PENDING.
  isToken0                  Boolean?
  poolFee                   Int?
  /// Phase 7B.5A §4 — batched/bounded-concurrency enrichment can leave a
  /// launch PENDING after a bad RPC read; the trade listener must not track
  /// this pool until enrichment completes (discoveryListener.ts's barrier).
  enrichmentStatus          EnrichmentStatus @default(COMPLETE)
  enrichmentAttempts        Int              @default(0)
  lastEnrichmentAttemptAt   DateTime?
  lastEnrichmentError       String?
  /// Phase 7B.5B §2 — verified on-chain via decimals(), never assumed to be
  /// 18 just because this is an EVM chain. Part of the same enrichment unit
  /// as supply/isToken0/poolFee: null (and enrichmentStatus PENDING) until
  /// a real decimals() read succeeds for both this token and quoteAddress.
  tokenDecimals             Int?
  quoteDecimals             Int?
  sourceHeight              BigInt
  sourceHash                String
  sourceTxHash              String
  sourceIndex               Int
  observedAt                DateTime         @default(now())
  /// Phase 7B.5A §2/§9 — set by reorgRecovery.ts when this launch's block is
  /// no longer canonical. Rows are never deleted, only marked, so orphaned
  /// history stays auditable; every read route filters canonicalStatus.
  canonicalStatus           ChainFactStatus  @default(CANONICAL)
  orphanedAt                DateTime?
  /// Populated by the graduation poller (§4.6), a scheduled read, never an
  /// event — Pons has no migration/graduation event. Null until first polled.
  graduated                 Boolean          @default(false)
  graduationPairedPrincipal Decimal?         @db.Decimal(78, 0)
  graduationThreshold       Decimal?         @db.Decimal(78, 0)
  graduationCheckedAt       DateTime?

  @@unique([chain, tokenAddress])
  @@index([chain, observedAt])
  @@index([chain, graduated])
  @@index([chain, poolAddress])
  @@index([chain, canonicalStatus, sourceHeight])
  @@index([chain, enrichmentStatus, sourceHeight])
}

model ChainTrade {
  id              String          @id @default(uuid())
  chain           String
  venue           String
  tokenAddress    String
  poolAddress     String?
  side            String // buy | sell
  tokenAmount     Decimal         @db.Decimal(78, 0)
  quoteAmount     Decimal         @db.Decimal(78, 0)
  quoteAddress    String
  priceQuote      Decimal         @db.Decimal(60, 18)
  trader          String
  sourceHeight    BigInt
  sourceHash      String
  sourceTxHash    String
  sourceIndex     Int
  observedAt      DateTime        @default(now())
  /// Phase 7B.5B §1 — the real source-chain block time (from the block's own
  /// `timestamp` field), never DB insertion time or API observation time.
  /// Nullable because it is an additive column: rows persisted before this
  /// phase (none exist in any real deployment yet, but the column must stay
  /// safe for any environment that already has trade rows) have no value
  /// until backfilled (scripts/backfillTradeTimestamps.ts) — until then such
  /// a row cannot contribute to a candle (fail closed, never fabricated).
  sourceTimestamp DateTime?
  /// Phase 7B.5A §2/§9 — same reorg bookkeeping as DiscoveredToken.
  canonicalStatus ChainFactStatus @default(CANONICAL)
  orphanedAt      DateTime?

  /// One log/instruction produces at most one trade fact — the EVM analog
  /// of PumpTrade's @@unique([signature, outerInstructionIndex, ...]).
  @@unique([chain, sourceTxHash, sourceIndex])
  @@index([chain, tokenAddress, sourceHeight])
  @@index([chain, canonicalStatus, sourceHeight])
  /// Phase 7B.5B — the candle aggregator's own read pattern: "canonical
  /// trades for this token, in source order, after my checkpoint."
  @@index([chain, tokenAddress, canonicalStatus, sourceHeight, sourceIndex])
}

/// Persists last-processed chain position per independent ingestion source
/// (e.g. "robinhood:pons:discovery", "robinhood:pons:trades") so a restart
/// resumes from here rather than re-scanning from genesis or silently
/// skipping the gap. Nothing in this repo implemented this before Phase
/// 7B.4 (confirmed by grep during Step 0) -- this table is the fix.
///
/// Phase 7B.5A §5/§9 extends this with the persisted, backend-owned facts the
/// source-health projection (sourceHealth.ts) reads — never inferred from a
/// live RPC call per API request, and never derived in the browser.
model ChainIngestionCheckpoint {
  source                  String    @id
  lastHeight              BigInt
  lastHash                String
  updatedAt               DateTime  @updatedAt
  /// Chain tip observed on the most recent poll (successful or not) — the
  /// basis for the health projection's block-lag figure.
  lastObservedChainHeight BigInt?
  /// Phase 7B.5B §10 — the real source-chain block time of `lastHeight`
  /// (the trade source only; discovery never sets this). A candle bucket
  /// may only become FINAL once this has moved past the bucket's end —
  /// "ingestion has safely progressed beyond it," never wall-clock time.
  lastHeightTimestamp     DateTime?
  lastPollAt              DateTime?
  lastSuccessAt           DateTime?
  lastError               String?
  lastErrorAt             DateTime?
  lastReorgAt             DateTime?
  /// Non-null while a detected reorg's common ancestor could not be found
  /// within the configured recovery window — the ingestion stream is halted
  /// (fail-closed) until this clears, either by a later tick finding an
  /// ancestor or by manual operator intervention.
  reorgUnresolvedAt       DateTime?
  reorgUnresolvedReason   String?
}

/// Phase 7B.5A §2 — a bounded, per-chain history of committed (height, hash)
/// pairs, independent of either listener's single-point checkpoint. Reorg
/// recovery (reorgRecovery.ts) walks this newest-to-oldest, comparing each
/// recorded hash against the live chain, to find the common canonical
/// ancestor within a bounded configured window (PONS_REORG_MAX_DEPTH_BLOCKS).
/// Pruned to that same window on every write so it never grows unbounded.
model ChainBlockCheckpoint {
  chain      String
  height     BigInt
  hash       String
  recordedAt DateTime @default(now())

  @@id([chain, height])
  @@index([chain, height])
}

// ---------------------------------------------------------------------------
// Phase 7B.5B — chain-neutral candle/OHLCV domain, backed by canonical
// ChainTrade rows. See ARCHITECTURE.md §21 for the full design; the short
// version: the aggregation algorithm (src/candles/aggregate.ts) is pure and
// knows nothing about Pons/EVM, only the normalized inputs these tables and
// src/discovery/types.ts already define.
// ---------------------------------------------------------------------------

/// Deliberately not named "1s"/"5s"/etc (not a legal Prisma/TS identifier) —
/// src/candles/resolutions.ts maps these to/from the chain-neutral string
/// literals the API and (eventually) the frontend actually use.
enum CandleResolution {
  S1
  S5
  S15
  M1
  M5
  M15
  H1
}

enum CandleStatus {
  PROVISIONAL
  FINAL
}

/// Materialized OHLCV candle. Identity is stable and idempotent:
/// (chain, tokenAddress, resolution, bucketStart). A row exists only for a
/// bucket that had at least one CANONICAL trade — no fake flat candles for
/// a quiet interval (phase7b5b.txt §5: "No-trade interval = no candle").
model MarketCandle {
  id                String           @id @default(uuid())
  chain             String
  venue             String
  tokenAddress      String
  quoteAddress      String
  resolution        CandleResolution
  bucketStart       DateTime
  /// Normalized (decimal-adjusted) execution price — see
  /// src/discovery/normalizedPrice.ts. Never the raw priceQuote ratio.
  open              Decimal          @db.Decimal(60, 18)
  high              Decimal          @db.Decimal(60, 18)
  low               Decimal          @db.Decimal(60, 18)
  close             Decimal          @db.Decimal(60, 18)
  volumeToken       Decimal          @db.Decimal(78, 0)
  volumeQuote       Decimal          @db.Decimal(78, 0)
  /// Null unless a verified historical quote->USD rate was actually applied
  /// to every trade in this bucket (§3) — never partially estimated.
  volumeUsd         Decimal?         @db.Decimal(38, 8)
  tradeCount        Int
  /// Distinct observed `ChainTrade.trader` values in this bucket — a swap
  /// recipient/router-facing address, not necessarily the ultimate economic
  /// user (§6). Never presented as a stronger "unique user" claim.
  uniqueTraders     Int
  status            CandleStatus
  /// Inclusive [firstSourceHeight, lastSourceHeight] of the canonical
  /// trades this bucket was built from — diagnostic only, not part of this
  /// row's identity (a reorg recompute can change these for the same
  /// bucket).
  firstSourceHeight BigInt
  lastSourceHeight  BigInt
  /// Bumped every time this row's values change (initial write = 1) — lets
  /// a realtime consumer (§14) detect and ignore an out-of-order update.
  revision          Int              @default(1)
  updatedAt         DateTime         @updatedAt
  createdAt         DateTime         @default(now())

  @@unique([chain, tokenAddress, resolution, bucketStart])
  @@index([chain, tokenAddress, resolution, bucketStart])
}

/// Phase 7B.5B §9 — reorg-safe candle invalidation. Written inside the same
/// transaction reorgRecovery.ts uses to orphan ChainTrade rows (one row per
/// affected tokenAddress), so a crash between orphaning trades and
/// invalidating their candles cannot happen. The candle worker processes
/// unprocessed rows by fully recomputing every bucket at or after
/// `invalidatedFromTimestamp` from `ChainTrade WHERE canonicalStatus =
/// CANONICAL` — never incremental arithmetic (OHLC is not safely
/// reversible by subtraction).
model CandleInvalidation {
  id                       String    @id @default(uuid())
  chain                    String
  tokenAddress             String
  invalidatedFromTimestamp DateTime
  createdAt                DateTime  @default(now())
  processedAt              DateTime?

  @@index([chain, processedAt])
  @@index([chain, tokenAddress, processedAt])
}

/// Phase 7B.5B §7/§8 — the candle worker's own per-token ingestion
/// progress, independent of the Pons trade checkpoint. Identity is (chain,
/// tokenAddress): the worker's next tick for a token resumes strictly
/// after (lastSourceHeight, lastSourceIndex) — the same height-then-index
/// total order the aggregator itself uses (§1).
model CandleAggregationCheckpoint {
  chain            String
  tokenAddress     String
  lastSourceHeight BigInt
  lastSourceIndex  Int
  updatedAt        DateTime @updatedAt

  @@id([chain, tokenAddress])
}
