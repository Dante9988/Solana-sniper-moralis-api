generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  id            String              @id @default(uuid())
  userId        String              @unique
  walletAddress String              @unique
  walletPk      String              @unique
  createdAt     DateTime            @default(now())
  config        UserConfig?
  balances      WalletBalance[]
  transactions  WalletTransaction[]
}

model UserConfig {
  id         String  @id @default(uuid())
  userId     String  @unique
  autoBuy    Boolean @default(false)
  buyAmount  Float   @default(0.1)
  takeProfit Float   @default(50)
  stopLoss   Float   @default(25)
  autoSell   Boolean @default(false)
  wallet     Wallet  @relation(fields: [userId], references: [userId])
}

model PumpFunToken {
  mint      String   @id
  createdAt DateTime @default(now())
  alerted   Boolean  @default(false)
}

model TokenAlert {
  id               String    @id @default(uuid())
  tokenAddress     String
  tokenSymbol      String?
  tokenName        String?
  initialMarketCap Float
  initialPrice     Float
  bundlePercentage Float?
  alertTimestamp   DateTime  @default(now())
  checked          Boolean   @default(false)
  pnlAlerted       Boolean   @default(false)
  pnlPercentage    Float?
  currentMarketCap Float?
  currentPrice     Float?
  checkTimestamp   DateTime?

  @@index([tokenAddress])
  @@index([checked])
  @@index([alertTimestamp])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String
  tokenMint   String
  tokenAmount Float
  solAmount   Float
  price       Float
  txHash      String
  timestamp   DateTime @default(now())
  status      String
  error       String?
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([tokenMint])
  @@index([timestamp])
}

model WalletBalance {
  id          String   @id @default(uuid())
  walletId    String
  tokenMint   String
  amount      Float
  lastUpdated DateTime @default(now())
  wallet      Wallet   @relation(fields: [walletId], references: [id])

  @@unique([walletId, tokenMint])
  @@index([walletId])
  @@index([tokenMint])
}

model UserPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  pumpSwapEnabled Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
