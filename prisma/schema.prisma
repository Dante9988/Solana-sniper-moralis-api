generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PumpFunToken {
  mint      String   @id
  createdAt DateTime @default(now())
  alerted   Boolean  @default(false)
}

model TokenAlert {
  id                String   @id @default(uuid())
  tokenAddress      String
  tokenSymbol       String?
  tokenName         String?
  initialMarketCap  Float
  initialPrice      Float
  bundlePercentage  Float?
  alertTimestamp    DateTime @default(now())
  checked           Boolean  @default(false)
  pnlAlerted        Boolean  @default(false)
  pnlPercentage     Float?
  currentMarketCap  Float?
  currentPrice      Float?
  checkTimestamp    DateTime?

  @@index([tokenAddress])
  @@index([checked])
  @@index([alertTimestamp])
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  type        String   // "BUY" or "SELL"
  tokenMint   String
  tokenAmount Float
  solAmount   Float
  price       Float
  txHash      String
  timestamp   DateTime @default(now())
  status      String   // "PENDING", "COMPLETED", "FAILED"
  error       String?

  @@index([walletId])
  @@index([tokenMint])
  @@index([timestamp])
}

model WalletBalance {
  id          String   @id @default(uuid())
  walletId    String
  tokenMint   String
  amount      Float
  lastUpdated DateTime @default(now())

  @@unique([walletId, tokenMint])
  @@index([walletId])
  @@index([tokenMint])
}
